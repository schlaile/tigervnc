+void SMsgReader::readDeviceLink()
+{
+  rdr::U8 subtype;
+  rdr::U16 channel;
+  rdr::U32 len;
+
+  subtype = is->readU8();
+  channel = is->readU16();
+  len = is->readU32();
+
+  if (len > deviceLinkMaxData)
+    throw Exception("Too large device link message");
+
+  std::vector<rdr::U8> data(len);
+  if (len > 0)
+    is->readBytes(&data[0], len);
+
+  handler->handleDeviceLink(subtype, channel, len ? &data[0] : NULL, len);
+}
