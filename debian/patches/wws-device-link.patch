+bool VNCSConnectionST::canOwnDeviceLinks()
+{
+  return state() == RFBSTATE_NORMAL &&
+         cp.supportsEncoding(pseudoEncodingDeviceLink) &&
+         (accessRights & AccessKeyEvents) && rfb::Server::acceptKeyEvents;
+}
