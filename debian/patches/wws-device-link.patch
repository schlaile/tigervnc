+void VNCSConnectionST::writeDeviceLinkOrClose(rdr::U8 subtype,
+                                              rdr::U16 channel,
+                                              const rdr::U8* data,
+                                              size_t len)
+{
+  try {
+    if (state() != RFBSTATE_NORMAL)
+      return;
+    writer()->writeDeviceLink(subtype, channel, data, len);
+  } catch(rdr::Exception& e) {
+    close(e.str());
+  }
+}
