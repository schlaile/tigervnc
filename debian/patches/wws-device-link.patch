+void SMsgWriter::writeDeviceLink(rdr::U8 subtype, rdr::U16 channel,
+                                 const rdr::U8* data, size_t len)
+{
+  if (!cp->supportsEncoding(pseudoEncodingDeviceLink))
+    throw Exception("Client does not support device links");
+  if (len > deviceLinkMaxData)
+    throw Exception("Too large device link message");
+
+  startMsg(msgTypeDeviceLink);
+  os->writeU8(subtype);
+  os->writeU16(channel);
+  os->writeU32(len);
+  if (len > 0)
+    os->writeBytes(data, len);
+  endMsg();
+}
