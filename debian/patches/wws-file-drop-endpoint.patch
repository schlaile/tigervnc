+void SMsgWriter::writeDesktopEndpointRect(const DesktopEndpoint& endpoint)
+{
+  if (!cp->supportsEncoding(pseudoEncodingDesktopEndpoint))
+    throw Exception("Client does not support desktop endpoints");
+  if (++nRectsInUpdate > nRectsInHeader && nRectsInHeader)
+    throw Exception("SMsgWriter::writeDesktopEndpointRect: nRects out of sync");
+  if (endpoint.service.size() > desktopEndpointMaxService ||
+      endpoint.url.size() > desktopEndpointMaxURL ||
+      endpoint.token.size() > desktopEndpointMaxToken)
+    throw Exception("SMsgWriter::writeDesktopEndpointRect: endpoint too long");
+
+  os->writeS16(0);
+  os->writeS16(0);
+  os->writeU16(0);
+  os->writeU16(0);
+  os->writeU32(pseudoEncodingDesktopEndpoint);
+  os->writeU8(desktopEndpointVersion);
+  os->writeU8(endpoint.flags);
+  os->pad(2);
+  os->writeU16(endpoint.service.size());
+  os->writeBytes(endpoint.service.data(), endpoint.service.size());
+  os->writeU16(endpoint.url.size());
+  os->writeBytes(endpoint.url.data(), endpoint.url.size());
+  os->writeU16(endpoint.token.size());
+  if (!endpoint.token.empty())
+    os->writeBytes(&endpoint.token[0], endpoint.token.size());
+}
