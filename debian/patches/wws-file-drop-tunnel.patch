+void SMsgWriter::writeEndpointTunnel(rdr::U8 subtype, rdr::U16 channel,
+                                     const rdr::U8* data, size_t len)
+{
+  if (len > (subtype == endpointTunnelData ? endpointTunnelMaxData
+                                           : endpointTunnelMaxPayload))
+    throw Exception("Too large endpoint tunnel message");
+
+  startMsg(msgTypeServerEndpointTunnel);
+  os->writeU8(subtype);
+  os->writeU16(channel);
+  os->writeU32(len);
+  if (len > 0)
+    os->writeBytes(data, len);
+  endMsg();
+}
