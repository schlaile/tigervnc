@@ -49,6 +51,29 @@ StringParameter SecurityServer::secTypes
 #endif
 ConfServer);
 
+static LogWriter vlog("SecurityServer");
+
+SecurityServer::SecurityServer(void) : Security(secTypes)
+{
+#ifdef HAVE_GNUTLS
+  // Clients must present a certificate, which only the X509 types ask
+  // for
+  if (SSecurityTLS::requireClientCert()) {
+    CharArray types(secTypes.getData());
+    std::list<U32> list = parseSecTypes(types.buf);
+    std::list<U32>::iterator i;
+    for (i = list.begin(); i != list.end(); ++i) {
+      if (*i != secTypeX509None && *i != secTypeX509Vnc &&
+          *i != secTypeX509Plain)
+        DisableSecType(*i);
+    }
+    if (GetEnabledExtSecTypes().empty())
+      vlog.error("X509ClientCA is set, but no X509 security type is "
+                 "enabled");
+  }
+#endif
+}
