+void SSecurityTLS::checkClientCert()
+{
+  gnutls_typed_vdata_st purpose;
+  const gnutls_datum_t* cert_list;
+  unsigned int cert_list_size = 0;
+  unsigned int status;
+  gnutls_x509_crt_t crt;
+  gnutls_datum_t dn;
+  std::string name;
+
+  // Refusals go to the client as the security result, with the reason,
+  // rather than as a TLS alert
+  cert_list = gnutls_certificate_get_peers(session, &cert_list_size);
+  if (cert_list_size == 0 ||
+      gnutls_certificate_type_get(session) != GNUTLS_CRT_X509)
+    throw AuthFailureException("No client certificate");
+
+  // GnuTLS rejects certificates whose extended key usage leaves out
+  // client authentication; checkPurpose() also rejects those without
+  // one, so that no server certificate of our authority will do
+  purpose.type = GNUTLS_DT_KEY_PURPOSE_OID;
+  purpose.data = (unsigned char*)GNUTLS_KP_TLS_WWW_CLIENT;
+  purpose.size = 0;
+  if (gnutls_certificate_verify_peers(session, &purpose, 1,
+                                      &status) != GNUTLS_E_SUCCESS)
+    throw AuthFailureException("Client certificate verification failed");
+
+  if (gnutls_x509_crt_init(&crt) != GNUTLS_E_SUCCESS)
+    throw AuthFailureException("gnutls_x509_crt_init failed");
+  if (gnutls_x509_crt_import(crt, &cert_list[0],
+                             GNUTLS_X509_FMT_DER) != GNUTLS_E_SUCCESS) {
+    gnutls_x509_crt_deinit(crt);
+    throw AuthFailureException("Failed to decode client certificate");
+  }
+
+  if (status == 0 && !checkPurpose(crt, GNUTLS_KP_TLS_WWW_CLIENT))
+    status = GNUTLS_CERT_INVALID | GNUTLS_CERT_PURPOSE_MISMATCH;
+
+  if (gnutls_x509_crt_get_dn3(crt, &dn, 0) == GNUTLS_E_SUCCESS) {
+    name = (const char*)dn.data;
+    gnutls_free(dn.data);
+  }
+  gnutls_x509_crt_deinit(crt);
+
+  if (status != 0) {
+    gnutls_datum_t status_str;
+    std::string reason;
+
+    if (gnutls_certificate_verification_status_print(
+          status, GNUTLS_CRT_X509, &status_str, 0) == GNUTLS_E_SUCCESS) {
+      reason = (const char*)status_str.data;
+      gnutls_free(status_str.data);
+    }
+    vlog.error("Client certificate %s rejected: %s", name.c_str(),
+               reason.c_str());
+    reason = "Client certificate rejected: " + reason;
+    throw AuthFailureException(reason.c_str());
+  }
+
+  vlog.info("Client certificate %s accepted", name.c_str());
+}
+
+bool SSecurityTLS::checkPurpose(gnutls_x509_crt_t crt, const char* oid)
+{
+  for (unsigned int i = 0; ; i++) {
+    char buf[128];
+    size_t size = sizeof(buf);
+    int err;
+
+    err = gnutls_x509_crt_get_key_purpose_oid(crt, i, buf, &size, NULL);
+    if (err == GNUTLS_E_SHORT_MEMORY_BUFFER)
+      continue;
+    if (err != GNUTLS_E_SUCCESS)
+      return false;
+    if (strcmp(buf, oid) == 0)
+      return true;
+  }
+}
+
 void SSecurityTLS::setParams(gnutls_session_t session)
 {
   static const char kx_anon_priority[] = ":+ANON-ECDH:+ANON-DH";
@@ -211,10 +314,32 @@ void SSecurityTLS::setParams(gnutls_sess
         GNUTLS_X509_FMT_PEM) != GNUTLS_E_SUCCESS)
       throw AuthFailureException("load of key failed");
 
+    if (requireClientCert()) {
+      CharArray ca(X509_ClientCAFile.getData());
+      CharArray crl(X509_ClientCRLFile.getData());
+
+      // Read for every connection, so that a new revocation list
+      // applies at once
+      if (gnutls_certificate_set_x509_trust_file(cert_cred, ca.buf,
+          GNUTLS_X509_FMT_PEM) < 1)
+        throw AuthFailureException("load of the certificate authority for "
+                                   "client certificates failed");
+
+      if (crl.buf[0] != '\0' &&
+          gnutls_certificate_set_x509_crl_file(cert_cred, crl.buf,
+            GNUTLS_X509_FMT_PEM) < 0)
+        throw AuthFailureException("load of the certificate revocation "
+                                   "list for client certificates failed");
+    }
+
     if (gnutls_credentials_set(session, GNUTLS_CRD_CERTIFICATE, cert_cred)
         != GNUTLS_E_SUCCESS)
       throw AuthFailureException("gnutls_credentials_set failed");
 
+    // Checked ourselves after the handshake, to tell the client why
+    if (requireClientCert())
+      gnutls_certificate_server_set_request(session, GNUTLS_CERT_REQUEST);
+
     vlog.debug("X509 session has been set");
 
   }
