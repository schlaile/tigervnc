+  // The cut text is Latin-1 (RFB): as UTF8_STRING converted, as
+  // COMPOUND_TEXT the same bytes (its default sets are ASCII and
+  // Latin-1), only C1 controls are not allowed there.
+  bool selectionRequest(Window requestor, Atom selection, Atom property,
+                        Atom target)
+  {
+    if (!cutText)
+      return false;
+    if (target == xaUTF8_STRING) {
+      std::string utf8;
+      for (int i = 0; i < cutTextLen; i++) {
+        unsigned char c = cutText[i];
+        if (c < 0x80) {
+          utf8 += (char)c;
+        } else {
+          utf8 += (char)(0xc0 | (c >> 6));
+          utf8 += (char)(0x80 | (c & 0x3f));
+        }
+      }
+      XChangeProperty(dpy, requestor, property, xaUTF8_STRING, 8,
+                      PropModeReplace, (const unsigned char*)utf8.data(),
+                      utf8.size());
+      return true;
+    }
+    if (target == xaCOMPOUND_TEXT) {
+      std::string ctext(cutText, cutTextLen);
+      for (size_t i = 0; i < ctext.size(); i++) {
+        unsigned char c = ctext[i];
+        if (c >= 0x80 && c < 0xa0)
+          ctext[i] = '?';
+      }
+      XChangeProperty(dpy, requestor, property, xaCOMPOUND_TEXT, 8,
+                      PropModeReplace, (const unsigned char*)ctext.data(),
+                      ctext.size());
+      return true;
+    }
+    return TXWindow::selectionRequest(requestor, selection, property,
+                                      target);
+  }
