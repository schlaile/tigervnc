#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=cmake

# Only the viewer: the X server would need the complete Xorg source.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DBUILD_VIEWER=ON \
		-DENABLE_PAM=OFF \
		-DENABLE_AUDIO=OFF \
		-DENABLE_H264=OFF \
		-DENABLE_SYSTEMD=OFF \
		-DINSTALL_SYSTEMD_UNITS=OFF \
		-DENABLE_NLS=OFF

override_dh_auto_install:
	install -D -m 0755 obj-$(DEB_HOST_GNU_TYPE)/vncviewer/vncviewer \
		debian/tigervnc-wws-viewer/usr/bin/tigervnc-wws-viewer

override_dh_auto_test:
