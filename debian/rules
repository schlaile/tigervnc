#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

PKG := debian/tigervnc-wws-viewer

%:
	dh $@ --buildsystem=cmake

# Only the viewer: the X server would need the complete Xorg source.
# Translations go to a directory of their own, so that they do not
# collide with the tigervnc.mo of the distribution's viewer.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DBUILD_VIEWER=ON \
		-DENABLE_PAM=OFF \
		-DENABLE_AUDIO=OFF \
		-DENABLE_H264=OFF \
		-DENABLE_SYSTEMD=OFF \
		-DINSTALL_SYSTEMD_UNITS=OFF \
		-DENABLE_NLS=ON \
		-DCMAKE_INSTALL_LOCALEDIR=share/tigervnc-wws-viewer/locale

# Only what the package needs: the AppStream file of "make all" needs ITS
# rules that the msgfmt of stretch does not have, and we do not ship it.
override_dh_auto_build:
	dh_auto_build -- vncviewer translations desktop

# Everything under names of its own next to the distribution's viewer:
# program, manual page, menu entry and icons (tigervnc-wws), translations.
# The command vncviewer comes through update-alternatives (postinst).
# Copied from the build directory, since "make install" builds "all".
BLD := obj-$(DEB_HOST_GNU_TYPE)
LOCALEDIR := $(PKG)/usr/share/tigervnc-wws-viewer/locale

override_dh_auto_install:
	install -D -m 0755 $(BLD)/vncviewer/vncviewer \
		$(PKG)/usr/bin/tigervnc-wws-viewer
	install -D -m 0644 vncviewer/vncviewer.man \
		$(PKG)/usr/share/man/man1/tigervnc-wws-viewer.1
	for lang in $$(cat po/LINGUAS); do \
	  install -D -m 0644 $(BLD)/po/$$lang.mo \
	    $(LOCALEDIR)/$$lang/LC_MESSAGES/tigervnc.mo; \
	done
	mkdir -p $(PKG)/usr/share/applications
	sed -e 's|^Exec=.*|Exec=/usr/bin/tigervnc-wws-viewer|' \
	    -e 's|^Icon=.*|Icon=tigervnc-wws|' \
	    -e 's|^\(Name\(\[[^]]*\]\)\{0,1\}=.*\)$$|\1 (WWS)|' \
		$(BLD)/vncviewer/vncviewer.desktop \
		>$(PKG)/usr/share/applications/tigervnc-wws-viewer.desktop
	install -D -m 0644 media/icons/tigervnc.svg \
		$(PKG)/usr/share/icons/hicolor/scalable/apps/tigervnc-wws.svg
	for res in 16 22 24 32 48 64 128; do \
	  install -D -m 0644 media/icons/tigervnc_$$res.png \
	    $(PKG)/usr/share/icons/hicolor/$${res}x$${res}/apps/tigervnc-wws.png; \
	done

override_dh_auto_test:
